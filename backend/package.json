{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "seed": "tsx src/seed.ts",
    "seed:categories": "tsx src/seedCategories.ts",
    "scrape:ingco": "tsx src/scrapers/ingco.scraper.ts",
    "import:ingco": "tsx src/importIngcoProducts.ts",
    "catalog:ingco": "npm run seed:categories && npm run scrape:ingco && npm run import:ingco",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.14"
  },
  "devDependencies": {
    "nodemon": "^3.1.3",
    "typescript": "^5.8.3",
    "tsx": "^4.20.3",
    "@types/node": "^22.15.30",
    "@types/express": "^5.0.3",
    "@types/cors": "^2.8.19",
    "@types/morgan": "^1.9.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^6.4.17",
    "@types/bcryptjs": "^2.4.6"
  }
}
